APP_NAME="Emissor NFS-e"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nfse.seudominio.com.br

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuariocpanel_nfse
DB_USERNAME=usuariocpanel_nfse
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log


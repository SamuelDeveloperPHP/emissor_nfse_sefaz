APP_NAME="Emissor NFS-e"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nfse.seudominio.com.br

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuariocpanel_nfse
DB_USERNAME=usuariocpanel_nfse
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log

# Transmissão ao ADN (valores padrão já apontam para os endereços oficiais; só mude se o governo mudar)
# NFSE_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
# NFSE_URL_PRODUCAO=https://sefin.nfse.gov.br/SefinNacional
# NFSE_ASSINATURA_ALGORITMO=sha1

# E-mail (para enviar a nota ao tomador). Com MAIL_MAILER=log nada é enviado de verdade.
# MAIL_MAILER=smtp
# MAIL_HOST=mail.seudominio.com.br
# MAIL_PORT=587
# MAIL_USERNAME=nfse@seudominio.com.br
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=nfse@seudominio.com.br
# MAIL_FROM_NAME="${APP_NAME}"
